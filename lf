          i_werks                  = space
          i_com_only               = space
          i_kalsm                  = lwa_kalsm
        TABLES
          t_ztrade_shop_prices_out = lt_shop_prices_out
          t_komv                   = lt_komv.

      IF sy-subrc = 0.

        CLEAR ynet.

        READ TABLE  lt_komv   WITH KEY
                        kschl =   'YNET'
                                    ASSIGNING <komv>.

        IF sy-subrc EQ 0.

*          MOVE <komv>-kwert TO ynet.
          MOVE <komv>-kbetr TO ynet.
          MOVE <komv>-kpein TO peinhx.

