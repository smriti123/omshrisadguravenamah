    CONSTANTS: lc_pruefregel TYPE bapit441v-prreg VALUE 'A',
*               lc_plant      TYPE werks_d         VALUE '1100',"20190226/Loewener el#498659
               lc_unit       TYPE meinh           VALUE 'ST'.

    TABLES: zel_egate_anfpro.

    DATA: lv_plant          TYPE bapimatvp-werks,
          lv_material       TYPE bapimatvp-matnr,
          lv_werksbestand   TYPE bapicm61v-wkbst,
          lv_unit           TYPE bapiadmm-unit.
    DATA: lv_dialogflag     TYPE bapicm61v-diafl,
          ls_return         TYPE bapireturn.
    DATA: lt_wmdvsx         TYPE TABLE OF bapiwmdvs,
          wa_wmdvsx         LIKE LINE OF lt_wmdvsx,
          lt_wmdvex         TYPE TABLE OF bapiwmdve,
          wa_wmdvex         LIKE LINE OF lt_wmdvex,
          lt_t006           TYPE TABLE OF t006,
          wa_t006           LIKE LINE OF lt_t006.
    DATA: wa_marm           TYPE marm,
          wa_marc           TYPE marc,
          wa_mara           TYPE mara,
          wa_makt           TYPE makt,
          wa_eina           TYPE eina,
          wa_t141t          TYPE t141t,
          lv_ean11          TYPE ean11,
          lv_werks          TYPE werks_d,
          lv_matnr          TYPE matnr,
          lv_bismt          TYPE mara-bismt,
          lv_meinh          TYPE meinh,
          lv_msehi          TYPE msehi,
          lv_isocode        TYPE t006-isocode,
          lv_idnlf          TYPE idnlf,
          lv_check_menge    TYPE char1,
          lv_verfuegbarkeit TYPE bapiwmdve-com_qty.
    DATA: lv_zz_freivn      TYPE mara-zz_freivn,
          lv_schalter(1)    TYPE c.

    DATA: entscheidung(2)   TYPE c,
          price             TYPE  float,
          priceunit         TYPE  string.

    DATA: lwa_shop_prices_out         TYPE ztrade_shop_prices_out.
    DATA: lt_shop_prices_out          TYPE TABLE OF ztrade_shop_prices_out.
    DATA: lwa_kalsm                   TYPE kalsm.
    DATA: lt_komv                     TYPE TABLE OF komv.
    DATA: t_ztrade_shop_material_mara TYPE TABLE OF ztrade_shop_material_mara.

    DATA: zeit              LIKE sy-datum.

**************************************
*#### BEGIN Validierung #########
    IF strcustomergln IS INITIAL.
*     Fehler! Pflichtfeld strcustomergln ist leer. Abbruch Verarbeitung
      MESSAGE e101(zwebservice) INTO str_remark.
      getexavailabilityresult = 512.
      str_itemstate           = getexavailabilityresult.
      dbl_amount              = 0.         "Menge
      EXIT.
    ENDIF.

* 11.05.2015 - MurgiaAn Inhalt nicht erforderlich.

*    IF strbranchgln IS INITIAL.
***     Fehler! Pflichtfeld strbranchgln ist leer. Abbruch Verarbeitung
**      MESSAGE e102(zwebservice) INTO str_remark.
**      EXIT.
*    ELSE.
*      IF strlen( strbranchgln ) > 4.
**       Fehler! Pflichtfeld strbranchgln ist ungültig. Abbruch Verarbeitung
*        MESSAGE e103(zwebservice) WITH strbranchgln INTO str_remark.
*        getexavailabilityresult = 512.
*        str_itemstate           = getexavailabilityresult.
*        dbl_amount              = 0.         "Menge
*        EXIT.
*      ENDIF.
*      lv_werks = strbranchgln.
**     Prüfe Werk
*      SELECT COUNT( * )
*      FROM t001w
*      WHERE werks = lv_werks.
*      IF sy-subrc <> 0.
**       Fehler! strBranchGLN &1 ist ungültig. Abbruch Verarbeitung
*        MESSAGE e103(zwebservice) WITH strbranchgln INTO str_remark.
*        getexavailabilityresult = 512.
*        str_itemstate           = getexavailabilityresult.
*        dbl_amount              = 0.         "Menge
*        EXIT.
*      ENDIF.
*    ENDIF.

    IF NOT stramountunit IS INITIAL.
      IF stramountunit = 'INH' OR "Zoll
         stramountunit = 'DAY' OR " Tage
         stramountunit = 'AMP' OR "Ampere
         stramountunit = 'DR'  OR " Bund/Trommel
         stramountunit = 'DMQ' OR " Kubikdezimeter
         stramountunit = 'CMT' OR " Zentimeter
         stramountunit = 'DMT' OR " Dezimeter
         stramountunit = 'GRM' OR " Gramm
         stramountunit = 'HUR' OR " Stunde
         stramountunit = 'HLT' OR " Hektoliter
         stramountunit = 'ANN' OR " Jahre
         stramountunit = 'CA'  OR " Kanister
         stramountunit = 'CT'  OR " Karton
         stramountunit = 'KGM' OR " Kilogramm
         stramountunit = 'CR'  OR " Kiste
         stramountunit = 'LE'  OR " Leistungseinheit
         stramountunit = 'LTR' OR " Liter
         stramountunit = 'MTR' OR " Meter
         stramountunit = 'MTK' OR " Quadratmeter
         stramountunit = 'MTQ' OR " Kubikmeter
         stramountunit = 'MIN' OR " Minute
         stramountunit = 'MTR' OR " Millimeter
         stramountunit = 'MON' OR " Monate
         stramountunit = 'PR'  OR " Paar
         stramountunit = 'PK'  OR " Pack
         stramountunit = 'PF'  OR " Palette
         stramountunit = 'RO'  OR " Rolle
         stramountunit = 'SEC' OR " Sekunde
         stramountunit = 'PCE' OR " Stück
         stramountunit = 'TNE' OR " Tonne
         stramountunit = 'WEE'.   " Wochen
      ELSE.
*       fehler! feld stramountunit &1 unbekannt. abbruch verarbeitung
        MESSAGE e105(zwebservice) WITH stramountunit INTO str_remark.
        getexavailabilityresult = 1024.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
    ENDIF.

*   Prüfe DEHA-Nummer
    IF NOT strdehaitemnumber IS INITIAL.
      lv_bismt = strdehaitemnumber.
      SELECT SINGLE * FROM mara
             INTO wa_mara
             WHERE bismt = lv_bismt.

      IF sy-subrc = 0.
        lv_matnr = wa_mara-matnr.
      ELSE.
*       Fehler! Feld strDEHAItemNumber: &1 unbekannt. Abbruch Verarbeitung
        MESSAGE e113(zwebservice) WITH strdehaitemnumber INTO str_remark.
        getexavailabilityresult = 256.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
    ELSE.
*     Von den drei Feldern "Artikelnr. EAN", "Artikelnr. des Herstellers"
*     und "Artikeltype" muß mindestens eines gefüllt sein.
      IF stritemgtin     IS INITIAL AND
         stritemsupplier IS INITIAL AND
         stritemtype     IS INITIAL.
*       Fehler! Pflichtfeldgr. &1, &2 oder &3 nicht gefüllt. Abbruch Verarbeitung
        MESSAGE e104(zwebservice) WITH 'stritemsupplier' 'stritemtype' 'stritemgtin' INTO str_remark.
        getexavailabilityresult = 512.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
    ENDIF.

*   Prüfung wenn Menge übergeben wurde
    IF NOT dblamount IS INITIAL.
*     Mengeneinheit
      IF NOT stramountunit IS INITIAL.
        lv_isocode = stramountunit.
        TRANSLATE lv_isocode TO UPPER CASE.
*       Mengeneinheit
        SELECT * FROM t006
            INTO TABLE lt_t006
            WHERE isocode = lv_isocode.
        IF sy-subrc = 0.
          lv_check_menge = 'X'.
          IF lines( lt_t006 ) = 1.
            READ TABLE lt_t006 INTO wa_t006 INDEX 1.
            lv_msehi = wa_t006-msehi.
          ELSE.
            LOOP AT lt_t006 INTO wa_t006.
              IF wa_t006-primary = 'X'.
                lv_msehi = wa_t006-msehi.
                EXIT.
              ELSE.
                lv_msehi = wa_t006-msehi.
              ENDIF.
            ENDLOOP.
          ENDIF.
        ELSE.
*         Fehler! Menge ohne Mengeneinheit. Abbruch Verarbeitung
          MESSAGE e106(zwebservice) INTO str_remark.
          getexavailabilityresult = 512.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = 0.         "Menge
          EXIT.
        ENDIF.
      ENDIF.
    ENDIF.

*#### ENDE Validierung #########
**************************************

    IF NOT stritemgtin IS INITIAL.
*     Ermittle Materialnummer anhand der ILN
      lv_ean11 = stritemgtin.

*     Suche über MARM da ein Index existiert
      SELECT SINGLE * FROM marm
             INTO wa_marm
             WHERE ean11 = lv_ean11.

      IF sy-subrc = 0.
        lv_matnr = wa_marm-matnr.
        lv_meinh = wa_marm-meinh.
      ELSE.
*       Fehler! Feld stritemgtin &1 ist ungültig. Abbruch Verarbeitung
        MESSAGE e108(zwebservice) WITH stritemgtin INTO str_remark.
        getexavailabilityresult = 512.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
**     Die Suche nur über MARA dauert zu lange da kein Index angelegt wurde
*      SELECT SINGLE matnr meins
*      FROM mara
*      INTO (lv_matnr, lv_meinh)
*      WHERE ean11 = lv_ean11.
*      IF sy-subrc <> 0.
**       Fehler! Feld stritemgtin &1 ist ungültig. Abbruch Verarbeitung
*        MESSAGE e108(zwebservice) WITH stritemgtin INTO str_remark.
*        EXIT.
*      ENDIF.
    ENDIF.

*   Artikelnr. des Herstellers aus Einkaufsinfosatz lesen
    IF ( NOT stritemsupplier IS INITIAL ) AND ( lv_matnr IS INITIAL ).

      lv_idnlf = stritemsupplier."Materialnummer beim Lieferanten
*     Lese aus Einkausfsinfosatz mit Materialnummer beim Lieferanten
      SELECT SINGLE matnr lmein FROM eina
             INTO (lv_matnr, lv_meinh)
             WHERE idnlf = lv_idnlf.

      IF sy-subrc <> 0.
*     Fehler! Feld stritemsupplier &1 ungültig. Abbruch Verarbeitung
        MESSAGE e109(zwebservice) WITH stritemsupplier INTO str_remark.
        getexavailabilityresult = 512.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
    ENDIF.

*   Artikeltype ist die (Deha-)Artikelnummer
    IF ( NOT stritemtype IS INITIAL ) AND ( lv_matnr IS INITIAL ).

      lv_matnr = stritemtype.
      SHIFT lv_matnr RIGHT DELETING TRAILING ' '.
      OVERLAY lv_matnr WITH '000000000000000000'.

*   Lese Einkausfsinfosatz
      SELECT SINGLE matnr lmein FROM eina
             INTO (lv_matnr, lv_meinh)
             WHERE matnr = lv_matnr.

      IF sy-subrc <> 0.
*     Fehler! Feld stritemtype &1 ungültig. Abbruch Verarbeitung
        MESSAGE e110(zwebservice) WITH stritemtype INTO str_remark.
        getexavailabilityresult = 512.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ENDIF.
    ENDIF.

*   Folgeprüfung des Artikels

    CLEAR wa_mara.
*   Bestimme Artikelstatus und Beschreibung
    SELECT SINGLE * FROM mara
           INTO wa_mara
           WHERE matnr = lv_matnr AND
                 lvorm = ' '.

    IF sy-subrc = 0.
*   Lese Artikelbezeichnung
      SELECT SINGLE * FROM makt
             INTO wa_makt
             WHERE matnr = lv_matnr AND
                   spras = sy-langu.

      IF sy-subrc = 0.
        str_itemdescription = wa_makt-zzmakttx3.
      ENDIF.

*   Lese Materialstatus aus Mat-/PPS-Sicht
      SELECT SINGLE * FROM t141t
             INTO wa_t141t
             WHERE mmsta = wa_mara-mstae AND
                   spras = sy-langu.

      IF sy-subrc = 0.
        str_itemstate = wa_t141t-mtstb.
      ENDIF.
    ELSE.
*     Fehler! Artikel &1 ungültig oder Material zum Löschen vorgemerkt.
      MESSAGE e111(zwebservice) WITH lv_matnr INTO str_remark.
      getexavailabilityresult = 256.
      str_itemstate           = getexavailabilityresult.
      dbl_amount              = 0.         "Menge
*     str_remark = 'Fehler! Artikel ungültig oder Material auf Mandantenebene zum Löschen vorgemerkt. Abbruch Verarbeitung'.
      EXIT.
    ENDIF.

    IF lv_werks IS NOT INITIAL.
*     Folgeprüfung des Artikels auf Werksdaten
      SELECT SINGLE * FROM marc
             INTO wa_marc
             WHERE matnr = lv_matnr AND
                   werks = lv_werks.

      IF sy-subrc <> 0.
*       Fehler! Filiale &1 für diesen Artikel &2 ungültig. Abbruch Verarbeitung
        MESSAGE e112(zwebservice) WITH lv_werks lv_matnr INTO str_remark.
        getexavailabilityresult = 512.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
        EXIT.
      ELSE.
*       Übergabe Werte an BAPI Felder
        lv_plant  = lv_werks.
      ENDIF.
    ENDIF.

*   Übergabe Werte an BAPI Felder
    lv_material = lv_matnr.
    IF lv_check_menge = 'X'.
      lv_unit = lv_msehi.
    ELSE.
      lv_unit = lv_meinh.
    ENDIF.

* 26.09.2012 - MurgiaAn Gesteuerte Antwort an Partner abhängig vom im materialstamm
*                       hinterlegten kennzeichen.
* 10.09.2013 - MurgiaAn Neues kennzeichen aus dem kundenstamm

    CLEAR lv_zz_freivn.
    CLEAR lv_schalter.

    SELECT SINGLE zz_freivn FROM mara
           INTO lv_zz_freivn
           WHERE matnr = lv_material.

    IF lv_zz_freivn = 'X'.
      MOVE 'J' TO lv_schalter.
    ELSE.
      MOVE 'N' TO lv_schalter.
    ENDIF.

    IF lv_schalter = 'J'.

*     Übergabe der Konstanten falls leer
*      IF lv_plant IS INITIAL."20190226/Loewener el#498659
*        lv_plant = lc_plant."20190226/Loewener el#498659
*      ENDIF."20190226/Loewener el#498659
      IF lv_unit IS INITIAL.
        lv_unit = lc_unit.
      ENDIF.

* 16.04.2013 - MurgiaAn die aus dem Funktionsbaustein errechnete Verfügbare Menge soll dem
*                       Dehapartner übergeben werden. lv_verfuegbarkeit --> dblamount
* 16.12.2013 - MurgiaAn Abgefragt darf nur die Filale "1100" werden, keine andere sonst.
*20190226/Loewener el#498659 Umbauen der Materialbestandsprüfung für den Werkswechsel

      CLEAR:   lv_verfuegbarkeit, lv_werksbestand.
      REFRESH: lt_wmdvsx, lt_wmdvex.

* Für den Fuba ZEL_GET_WERTE
      DATA: lt_liste TYPE TABLE OF zel_wert,
            lv_werk  TYPE werks_d.

      FIELD-SYMBOLS: <werk> TYPE zel_wert.

      CALL FUNCTION 'ZEL_GET_WERTE'
        EXPORTING
          iv_zkey         = 'Z_GETEXAVAILABILITY_WERK'
         iv_repid        = sy-repid
     IMPORTING
*   EV_WERT         = EV_WERT
        et_liste        = lt_liste
* EXCEPTIONS
*   NOT_FOUND       = 1
*   NO_VALUE        = 2
*   OTHERS          = 3
    .

      LOOP AT lt_liste ASSIGNING <werk>.

        MOVE <werk> TO lv_werk.

* ATP-Auskunft
        CALL FUNCTION 'BAPI_MATERIAL_AVAILABILITY'
          EXPORTING
            plant      = lv_werk
*           plant      = lv_plant
            material   = lv_material
            UNIT       = lv_unit
*           check_rule = lc_pruefregel "Als Prüfregel wird im Funktionsbaustein die des Vertriebs (A) herangezogen
          IMPORTING
            av_qty_plt = lv_werksbestand
            dialogflag = lv_dialogflag
            return     = ls_return
          TABLES
            wmdvsx     = lt_wmdvsx
            wmdvex     = lt_wmdvex."Ausgabetabelle (Termin(e) und ATP-Menge(n))

        LOOP AT lt_wmdvex INTO wa_wmdvex.
*       Die verfügbare Menge (ATP = Available-to-promise) ist die Menge,
*       die noch für die Bestätigung neu eintreffender Aufträge verfügbar ist.
*       Die ATP-Menge berechnet sich nach folgender Formel:
*       ATP-Menge = Lagerbestand + geplante Zugänge - geplante Abgänge
          IF wa_wmdvex-com_date = sy-datum.
            ADD wa_wmdvex-com_qty TO lv_verfuegbarkeit .
          ENDIF.
        ENDLOOP.
        REFRESH lt_wmdvex.
        CLEAR: wa_wmdvex, lv_werk.
      ENDLOOP.

      FREE <werk>.


*20190226/Loewener el#498659

** ATP-Auskunft
*      CALL FUNCTION 'BAPI_MATERIAL_AVAILABILITY'
*        EXPORTING
*          plant      = '1100'
**         plant      = lv_plant
*          material   = lv_material
*          unit       = lv_unit
**         check_rule = lc_pruefregel "Als Prüfregel wird im Funktionsbaustein die des Vertriebs (A) herangezogen
*        IMPORTING
*          av_qty_plt = lv_werksbestand
*          dialogflag = lv_dialogflag
*          return     = ls_return
*        TABLES
*          wmdvsx     = lt_wmdvsx
*          wmdvex     = lt_wmdvex."Ausgabetabelle (Termin(e) und ATP-Menge(n))
*      LOOP AT lt_wmdvex INTO wa_wmdvex.
**       Die verfügbare Menge (ATP = Available-to-promise) ist die Menge,
**       die noch für die Bestätigung neu eintreffender Aufträge verfügbar ist.
**       Die ATP-Menge berechnet sich nach folgender Formel:
**       ATP-Menge = Lagerbestand + geplante Zugänge - geplante Abgänge
*        IF wa_wmdvex-com_date = sy-datum.
*          ADD wa_wmdvex-com_qty TO lv_verfuegbarkeit .
*        ENDIF.
*      ENDLOOP.

* 13.11.2014 - MurgiaAn, dblamount wird im falle von teilverfügbarkeit durch 0
*                        überschrieben statt die original abgefragte Menge zurückzugeben.

      IF sy-subrc = 0.
        "0 = nicht verfügbar
        "1 = voll verfügbar
        "2 = Teilverfügbar
        IF lv_check_menge = 'X'.
          IF lv_verfuegbarkeit >= dblamount."Wenn Größergleich => voll verfügbar
            getexavailabilityresult = 1.
            str_remark = 'voll verfügbar'.
            str_itemstate           = getexavailabilityresult.
            dbl_amount              = dblamount.         "Menge
          ELSE.
            IF lv_verfuegbarkeit > 0. "Wenn größer 0 => Teilverfügbar
              getexavailabilityresult = 2.
              str_remark = 'Teilverfügbar'.
              str_itemstate           = getexavailabilityresult.
              dbl_amount              = lv_verfuegbarkeit.
            ELSE.
              getexavailabilityresult = 4."sonst nicht verfügbar
              str_remark = 'nicht verfügbar'.
              str_itemstate           = getexavailabilityresult.
              dbl_amount              = 0.         "Menge
            ENDIF.
          ENDIF.
        ELSE.
          IF lv_verfuegbarkeit > 0.
            getexavailabilityresult = 1."Wenn Größer => voll verfügbar
            str_remark = 'voll verfügbar'.
            str_itemstate           = getexavailabilityresult.
            dbl_amount              = dblamount.         "Menge
          ELSE.
            getexavailabilityresult = 4."sonst nicht verfügbar
            str_remark = 'nicht verfügbar'.
            str_itemstate           = getexavailabilityresult.
            dbl_amount              = 0.         "Menge
          ENDIF.
        ENDIF.
      ELSE.
*   Kein Bestand
        getexavailabilityresult = 4."sonst nicht verfügbar
        str_remark = 'keine ATP-Menge verfügbar'.
        str_itemstate           = getexavailabilityresult.
        dbl_amount              = 0.         "Menge
      ENDIF.

      IF NOT ls_return-message IS INITIAL.
        str_remark          = ls_return-message.  "Anmerkungen
      ENDIF.
    ELSE.
      getexavailabilityresult = 4."sonst nicht verfügbar
      str_remark = 'nicht verfügbar'.
      str_itemstate           = getexavailabilityresult.
      dbl_amount              = 0.         "Menge
    ENDIF.

* 14.02.2013 - MurgiaAn Diverse Prüfungen auf Materialebene.

    DATA: w_auslaufkz     LIKE mara-mstae.

    CLEAR w_auslaufkz.

    SELECT SINGLE mstae FROM mara
           INTO w_auslaufkz
           WHERE matnr = lv_material.

    CASE w_auslaufkz.
      WHEN 'W1'.
        IF getexavailabilityresult = 4.
          getexavailabilityresult = 52. "nicht Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'nicht Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = 0.         "Menge
        ENDIF.
        IF getexavailabilityresult = 2.
          getexavailabilityresult = 50. "Teilweise Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'Teilweise Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = lv_verfuegbarkeit.
        ENDIF.
        IF getexavailabilityresult = 1.
          getexavailabilityresult = 49. "Voll Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'Voll Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = dblamount.
        ENDIF.
      WHEN 'W2'.
        IF getexavailabilityresult = 4.
          getexavailabilityresult = 52. "nicht Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'nicht Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = 0.         "Menge
        ENDIF.
        IF getexavailabilityresult = 2.
          getexavailabilityresult = 50. "Teilweise Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'Teilweise Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = lv_verfuegbarkeit.
        ENDIF.
        IF getexavailabilityresult = 1.
          getexavailabilityresult = 49. "Voll Verfügbar, Auslaufartikel, Nachlieferung nicht möglich
          str_remark              = 'Voll Verfügbar, Auslaufartikel, Nachlieferung nicht möglich'.
          str_itemstate           = getexavailabilityresult.
          dbl_amount              = dblamount.
        ENDIF.
      WHEN 'X1'.
