      CLEAR i_vkorg.
      CLEAR i_vtweg.
      CLEAR i_spart.

      CLEAR peinhx.
      CLEAR peinhx2.

      SELECT SINGLE vkorg vtweg spart FROM knvv
             INTO (i_vkorg, i_vtweg, i_spart)
             WHERE kunnr = x_kunde   AND
                   loevm NE 'X'      AND
                   aufsd = ''        AND
                   loevm = ''.

